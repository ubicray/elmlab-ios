"NSMicrophoneUsageDescription" = "Elm Lab snima zvuk iz mikrofona, kao i kod drugih senzora, i analizira ga prema odabranom pokusu. Podaci će biti izvezeni iz aplikacije samo ako korisnik odluči izvesti koristeći funkciju za izvoz podataka.";
"NSLocationWhenInUseUsageDescription" = "Elm Lab snima podatke iz GPS-a, kao i kod drugih senzora, i analizira ga prema odabranom pokusu. Podaci će biti izvezeni iz aplikacije samo ako korisnik odluči izvesti koristeći funkciju za izvoz podataka.";
"NSPhotoLibraryAddUsageDescription" = "Elm Lab može dodati snimke zaslona u Vašu biblioteku slika ako odaberete \"Podijeli snimku zaslona\" iz izbornika pokusa.";
"NSMotionUsageDescription" = "Elm Lab čita senzore Vašeg mobilnog uređaja kako bi ih mogao koristiti u fizikalnim pokusima.";
"NSCameraUsageDescription" = "Elm Lab koristi kameru za skeniranje QR kodova, koji se mogu koristiti za dodavanje prilagođenih postavki pokusa. Kamera se također koristi kao uređaj za mjerenje kod optičkih pokusa i pokusa s dubinskim senzorom (LiDAR/ToF).";
"NSBluetoothPeripheralUsageDescription" = "Elm Lab ima mogućnost čitanja s vanjskih Bluetooth senzora i zapisivanje podataka na vanjske Bluetooth uređaje. Možete naučiti više o ovoj mogućnosti i podržanim uređajima na ttp://phyphox.org/ble.";
"NSBluetoothAlwaysUsageDescription" = "Elm Lab ima mogućnost čitanja s vanjskih Bluetooth senzora i zapisivanje podataka na vanjske Bluetooth uređaje. Možete naučiti više o ovoj mogućnosti i podržanim uređajima na http://phyphox.org/ble.";
